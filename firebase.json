{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "jospar", "region": "europe-west1"}},
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "firestore": {"rules": "firestore.rules"}
}
