{
  "name": "jospar",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "setup": "npm ci && npm run build && npm ci --prefix server",
    "test": "node --test tests/*.test.js",
    "build": "esbuild src/firebase-client.js --bundle --format=esm --minify --outfile=public/firebase-client.js && esbuild src/firebase-messaging-sw.js --bundle --format=iife --minify --outfile=public/firebase-messaging-sw.js",
    "test:firebase": "firebase emulators:exec --project demo-jospar --only auth,firestore \"node --test tests/firebase-rules.cjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.2",
    "playwright": "1.58.2"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
