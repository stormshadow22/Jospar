rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function verified(){return signed() && (request.auth.token.get('email_verified',false)==true || request.auth.token.get('phone_number','').size()>0);}
  function own(uid){return verified() && request.auth.uid==uid;}
  function team(id){return get(/databases/$(database)/documents/teams/$(id)).data;}
  function member(id){return verified() && request.auth.uid in team(id).memberIds;}
  function owner(id){return verified() && team(id).ownerId==request.auth.uid;}
  function validProfile(p){return p.keys().hasOnly(['username','displayName','bio','avatarURL','createdAt']) && p.username is string && p.username.matches('^[^/]{3,20}$') && p.displayName is string && p.displayName.size()>0 && p.displayName.size()<=80 && p.bio is string && p.bio.size()<=300 && p.avatarURL is string && p.avatarURL.size()<=120000 && (p.avatarURL=='' || p.avatarURL.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+') || p.avatarURL.matches('https://firebasestorage.googleapis.com/.*') || p.avatarURL.matches('http://127.0.0.1:9199/.*'));}
  function validState(d){return d==null || (d is map && d.tasks is list && d.tasks.size()<=3000 && d.projects is list && d.projects.size()<=3000 && d.habits is list && d.habits.size()<=3000 && d.goals is list && d.goals.size()<=3000 && d.survey is map);}
  match /publicProfiles/{uid}{
   allow read: if verified();
   allow create: if own(uid) && validProfile(request.resource.data) && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid==uid;
   allow update: if own(uid) && validProfile(request.resource.data) && request.resource.data.username==resource.data.username && request.resource.data.createdAt==resource.data.createdAt;
   allow delete: if own(uid) && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username.lower()));
  }
  match /usernames/{name}{
   allow get: if verified(); allow list: if false;
   allow create: if verified() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid==request.auth.uid && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username.lower()==name;
   allow update: if false;allow delete: if verified() && resource.data.uid==request.auth.uid && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
  }
  match /users/{uid}{
   allow get: if own(uid); allow list: if false;
   allow create: if own(uid) && request.resource.data.keys().hasOnly(['profile','data','version']) && request.resource.data.version==0 && validState(request.resource.data.data);
   allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data','version']) && request.resource.data.version==resource.data.version+1 && validState(request.resource.data.data);
   allow delete: if own(uid);
   match /devices/{id}{allow read,delete: if own(uid);allow create,update: if own(uid) && request.resource.data.keys().hasOnly(['token','enabled','updatedAt']) && request.resource.data.token is string && request.resource.data.token.size()>=50 && request.resource.data.token.size()<=4096 && request.resource.data.enabled is bool && request.resource.data.updatedAt==request.time;}
   match /notifications/{id}{allow read: if own(uid);allow create: if false;allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;allow delete: if own(uid);}
  }
  function inviteRecipient(i){return verified() && (i.email=='' || (request.auth.token.email is string && request.auth.token.email.lower()==i.email));}
  function accepting(id){let before=get(/databases/$(database)/documents/invitations/$(id)).data;let after=getAfter(/databases/$(database)/documents/invitations/$(id)).data;return before.status=='pending' && before.expiresAt>request.time && inviteRecipient(before) && after.status=='accepted' && after.acceptedBy==request.auth.uid;}
  match /pushDevices/{id}{allow read,delete: if verified() && resource.data.uid==request.auth.uid;allow create,update: if verified() && request.resource.data.keys().hasOnly(['uid','token','enabled','updatedAt']) && request.resource.data.uid==request.auth.uid && request.resource.data.token is string && request.resource.data.token.size()>=50 && request.resource.data.token.size()<=4096 && request.resource.data.enabled is bool && request.resource.data.updatedAt==request.time;}
  match /teams/{id}{
   allow read: if verified() && request.auth.uid in resource.data.memberIds;
   allow create: if verified() && request.resource.data.keys().hasOnly(['name','ownerId','memberIds','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && request.resource.data.ownerId==request.auth.uid && request.resource.data.memberIds==[request.auth.uid] && request.resource.data.createdAt==request.time;
   allow update: if verified() && (
    (resource.data.ownerId==request.auth.uid && request.resource.data.ownerId==resource.data.ownerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','memberIds','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && request.resource.data.memberIds is list && request.resource.data.memberIds.size()<=50 && request.auth.uid in request.resource.data.memberIds && resource.data.memberIds.hasAll(request.resource.data.memberIds)) ||
    (resource.data.ownerId==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId','updatedAt']) && request.resource.data.ownerId in resource.data.memberIds) ||
    (request.auth.uid in resource.data.memberIds && request.resource.data.ownerId==resource.data.ownerId && request.auth.uid!=resource.data.ownerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','updatedAt']) && request.resource.data.memberIds==resource.data.memberIds.removeAll([request.auth.uid])) ||
    (!(request.auth.uid in resource.data.memberIds) && request.resource.data.ownerId==resource.data.ownerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','joinInviteId','updatedAt']) && request.resource.data.memberIds==resource.data.memberIds.concat([request.auth.uid]) && request.resource.data.memberIds.size()<=50 && accepting(request.resource.data.joinInviteId) && get(/databases/$(database)/documents/invitations/$(request.resource.data.joinInviteId)).data.teamId==id)
   );
   allow delete: if false;
   match /messages/{message}{
    allow read: if member(id);
    allow create: if member(id) && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.resource.data.senderId==request.auth.uid && request.resource.data.senderName==get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.displayName && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=4000 && request.resource.data.createdAt==request.time;
    allow update: if false;allow delete: if member(id) && (resource.data.senderId==request.auth.uid || owner(id));
   }
   match /reads/{uid}{allow read: if member(id);allow create,update: if own(uid) && member(id) && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt==request.time;allow delete: if false;}
  }
  match /invitations/{id}{
   allow get: if verified() && (resource.data.createdBy==request.auth.uid || inviteRecipient(resource.data));
   allow list: if verified() && (resource.data.createdBy==request.auth.uid || (request.auth.token.email is string && resource.data.email==request.auth.token.email.lower()));
   allow create: if verified() && owner(request.resource.data.teamId) && request.resource.data.keys().hasOnly(['teamId','teamName','createdBy','email','status','createdAt','expiresAt']) && request.resource.data.teamName==team(request.resource.data.teamId).name && request.resource.data.createdBy==request.auth.uid && request.resource.data.email is string && request.resource.data.email.size()<=254 && request.resource.data.email==request.resource.data.email.lower() && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time && request.resource.data.expiresAt>request.time && request.resource.data.expiresAt<=request.time+duration.value(8,'d');
   allow update: if (resource.data.createdBy==request.auth.uid && verified() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status=='revoked') ||
    (inviteRecipient(resource.data) && resource.data.status=='pending' && resource.data.expiresAt>request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy','acceptedAt']) && request.resource.data.status=='accepted' && request.resource.data.acceptedBy==request.auth.uid && request.resource.data.acceptedAt==request.time && request.auth.uid in getAfter(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds);
   allow delete: if false;
  }
 }
}
