# Copy to .env on your own computer; never commit .env or a private key.
PORT=8085
FIREBASE_PROJECT_ID=jospar-fcaa0
JOSPAR_PUSH_WORKER=1
# Use a LOCAL private-key file outside the repository. Example Windows path:
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_NAME/.jospar/firebase-admin.json
# Only for the optional Docker push override (same LOCAL file):
FIREBASE_ADMIN_FILE=C:/Users/YOUR_NAME/.jospar/firebase-admin.json
